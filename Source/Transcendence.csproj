<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Transcendence</AssemblyName>
    <RootNamespace>Transcendence</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- RimWorld 1.7 kurulumu ve Harmony (Workshop) yolları. Farklıysa burayı düzenle. -->
    <RimWorldDir>D:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir>D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>

    <!-- Wiki'nin 1.7 önerileri -->
    <OutputPath>../1.7/Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Private=false => "Copy Local = False": oyun ve Harmony DLL'leri mod klasörüne kopyalanmaz -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Derlemeden sonra modu oyunun Mods klasörüne kopyala.
       Sadece oyunun kullandığı dosyalar gider; kaynak kod, git ve repo dosyaları Workshop'a yüklenmesin. -->
  <PropertyGroup>
    <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
  </PropertyGroup>
  <Target Name="DeployToGame" AfterTargets="Build">
    <!-- Workshop'a ilk yüklemeden sonra oyun About/PublishedFileId.txt'yi sadece oyun klasörüne yazar.
         Repoya geri al: sonraki yüklemeler yeni sayfa açmak yerine aynı Workshop sayfasını günceller. -->
    <Copy SourceFiles="$(RimWorldDir)\Mods\Transcendence\About\PublishedFileId.txt"
          DestinationFolder="$(ModRoot)\About"
          Condition="Exists('$(RimWorldDir)\Mods\Transcendence\About\PublishedFileId.txt') And !Exists('$(ModRoot)\About\PublishedFileId.txt')" />
    <ItemGroup>
      <ModFiles Include="$(ModRoot)\**\*"
                Exclude="$(ModRoot)\Source\**;$(ModRoot)\.git\**;$(ModRoot)\.github\**;$(ModRoot)\.vs\**;$(ModRoot)\.idea\**;$(ModRoot)\.gitignore;$(ModRoot)\.gitattributes;$(ModRoot)\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(RimWorldDir)\Mods\Transcendence\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
